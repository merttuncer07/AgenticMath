# Antiderivatives of the elementary functions of a linear argument, as rules for antiderivative(f, x), which
# integrate(f, x) consults; integrate then checks every result by differentiation. integrate (in C) applies linearity, takes
# out constant factors, integrates rational functions exactly and polynomials times exp, sin, cos, log or atan by
# parts; these rules handle what is left. Every result is checked by differentiating it back.
linear(u, x) := degree(u, x) == 1 and free(diff(u, x), x)
antiderivative(exp(u), x) := exp(u)/diff(u, x) if linear(u, x)
antiderivative(sin(u), x) := -cos(u)/diff(u, x) if linear(u, x)
antiderivative(cos(u), x) := sin(u)/diff(u, x) if linear(u, x)
antiderivative(tan(u), x) := -log(cos(u))/diff(u, x) if linear(u, x)
antiderivative(log(u), x) := (u*log(u) - u)/diff(u, x) if linear(u, x)
antiderivative(atan(u), x) := (u*atan(u) - log(1 + u^2)/2)/diff(u, x) if linear(u, x)
antiderivative(sqrt(u), x) := 2*u*sqrt(u)/(3*diff(u, x)) if linear(u, x)

# products of exponentials and trigonometric functions of linear arguments
antiderivative(exp(u)*sin(v), x) := exp(u)*(diff(u, x)*sin(v) - diff(v, x)*cos(v))/(diff(u, x)^2 + diff(v, x)^2) if linear(u, x) and linear(v, x)
antiderivative(exp(u)*cos(v), x) := exp(u)*(diff(u, x)*cos(v) + diff(v, x)*sin(v))/(diff(u, x)^2 + diff(v, x)^2) if linear(u, x) and linear(v, x)
antiderivative(sin(u)*cos(u), x) := sin(u)^2/(2*diff(u, x)) if linear(u, x)
antiderivative(sin(u)^2, x) := u/(2*diff(u, x)) - sin(u)*cos(u)/(2*diff(u, x)) if linear(u, x)
antiderivative(cos(u)^2, x) := u/(2*diff(u, x)) + sin(u)*cos(u)/(2*diff(u, x)) if linear(u, x)
antiderivative(exp(u)^n, x) := exp(u)^n/(n*diff(u, x)) if linear(u, x)

# powers of a square root of a linear argument (n = -1 is 1/sqrt(u))
antiderivative(sqrt(u)^n, x) := 2*sqrt(u)^(n + 2)/((n + 2)*diff(u, x)) if linear(u, x) and n != -2
antiderivative(sqrt(u)^n, x) := log(u)/diff(u, x) if linear(u, x) and n == -2

# products of sines and cosines of different linear arguments, by the product-to-sum formulas
antiderivative(sin(u)*cos(v), x) := -cos(u + v)/(2*diff(u + v, x)) - cos(u - v)/(2*diff(u - v, x)) if linear(u, x) and linear(v, x) and diff(u - v, x) != 0 and diff(u + v, x) != 0
antiderivative(sin(u)*sin(v), x) := sin(u - v)/(2*diff(u - v, x)) - sin(u + v)/(2*diff(u + v, x)) if linear(u, x) and linear(v, x) and diff(u - v, x) != 0 and diff(u + v, x) != 0
antiderivative(cos(u)*cos(v), x) := sin(u - v)/(2*diff(u - v, x)) + sin(u + v)/(2*diff(u + v, x)) if linear(u, x) and linear(v, x) and diff(u - v, x) != 0 and diff(u + v, x) != 0

# square roots of quadratics: a = coeff(u, x, 2), b = coeff(u, x, 1), c = coeff(u, x, 0)
quadratic(u, x) := degree(u, x) == 2 and free(diff(u, x, 2), x)
antiderivative(sqrt(u)^n, x) := -asin((2*coeff(u, x, 2)*x + coeff(u, x, 1))/sqrt(coeff(u, x, 1)^2 - 4*coeff(u, x, 2)*coeff(u, x, 0)))/sqrt(-coeff(u, x, 2)) if n == -1 and quadratic(u, x) and coeff(u, x, 2) < 0
antiderivative(sqrt(u)^n, x) := log(2*sqrt(coeff(u, x, 2))*sqrt(u) + 2*coeff(u, x, 2)*x + coeff(u, x, 1))/sqrt(coeff(u, x, 2)) if n == -1 and quadratic(u, x) and coeff(u, x, 2) > 0
antiderivative(sqrt(u), x) := (2*coeff(u, x, 2)*x + coeff(u, x, 1))*sqrt(u)/(4*coeff(u, x, 2)) + (4*coeff(u, x, 2)*coeff(u, x, 0) - coeff(u, x, 1)^2)/(8*coeff(u, x, 2))*antiderivative(sqrt(u)^(-1), x) if quadratic(u, x)

# exp of a quadratic with a negative leading coefficient: the error function
antiderivative(exp(u), x) := sqrt(pi)*exp(coeff(u, x, 0) - coeff(u, x, 1)^2/(4*coeff(u, x, 2)))*erf(sqrt(-coeff(u, x, 2))*x - coeff(u, x, 1)/(2*sqrt(-coeff(u, x, 2))))/(2*sqrt(-coeff(u, x, 2))) if quadratic(u, x) and coeff(u, x, 2) < 0

# the sine integral: sin(a x)/x
antiderivative(sin(u)*v^n, x) := Si(u) if n == -1 and v == x and linear(u, x) and coeff(u, x, 0) == 0
