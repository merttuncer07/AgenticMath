# The prelude: rules every statement can use. Written in the language itself; the C core only knows arithmetic,
# the engines, and how to apply rules.

# derivatives of the elementary functions; diff applies the chain rule through them
diff(sin(u), x) := cos(u)*diff(u, x)
diff(cos(u), x) := -sin(u)*diff(u, x)
diff(tan(u), x) := (1 + tan(u)^2)*diff(u, x)
diff(exp(u), x) := exp(u)*diff(u, x)
diff(log(u), x) := diff(u, x)/u
diff(sqrt(u), x) := diff(u, x)/(2*sqrt(u))
diff(atan(u), x) := diff(u, x)/(1 + u^2)
diff(asin(u), x) := diff(u, x)/sqrt(1 - u^2)
diff(acos(u), x) := -diff(u, x)/sqrt(1 - u^2)

# simplifications that hold for every complex argument
exp(log(u)) := u

# more functions, defined through the basic ones
sec(u) := 1/cos(u)
csc(u) := 1/sin(u)
cot(u) := cos(u)/sin(u)
sinh(u) := (exp(u) - exp(-u))/2
cosh(u) := (exp(u) + exp(-u))/2
tanh(u) := (exp(u) - exp(-u))/(exp(u) + exp(-u))
asinh(u) := log(u + sqrt(u^2 + 1))
acosh(u) := log(u + sqrt(u^2 - 1))
atanh(u) := log((1 + u)/(1 - u))/2
diff(erf(u), x) := 2*exp(-u^2)/sqrt(pi)*diff(u, x)
diff(Si(u), x) := sin(u)/u*diff(u, x)

# names other systems use
arcsin(u) := asin(u)
arccos(u) := acos(u)
arctan(u) := atan(u)
factorial(n) := n!
log10(u) := log(u)/log(10)
log2(u) := log(u)/log(2)
